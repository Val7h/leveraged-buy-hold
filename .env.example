# LBH System — .env.example (raiz)
# Copie para .env e preencha. NUNCA commite .env real.

# === Cache (Upstash Redis - HTTP) ===
# Crie em https://console.upstash.com/redis (free tier: 10k cmd/dia).
# Sem estas vars, o app cai para cache in-memory (so sobrevive a 1 instancia / cold-start).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === Database (futuro - Postgres) ===
# Modo demo nao usa. Preencher quando o Track Backend reativar persistencia.
DATABASE_URL=

# === App ===
NODE_ENV=development
# URL publica da API (mesmo dominio do Next em prod).
NEXT_PUBLIC_API_URL=http://localhost:3000

# === Stripe (opcional - modo demo nao precisa) ===
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
