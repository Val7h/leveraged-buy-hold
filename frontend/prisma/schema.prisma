// LBH System — Prisma schema
// All PKs use cuid() to avoid enumeration / IDOR. Decimal columns avoid FP drift.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  fullName     String?
  riskProfile  String      @default("moderado")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  portfolios       Portfolio[]
  watchlists       Watchlist[]
  alerts           Alert[]
  notifications    Notification[]
  subscription     Subscription?
  emailPreference  EmailPreference?
  passwordResets   PasswordResetToken[]

  @@map("users")
}

// Reset de senha por email. Token e sha256 do valor enviado por email
// (nunca armazenamos plain). Expira em 1h, used uma vez.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// LGPD art. 18 — direito de opt-out de comunicacoes nao-essenciais.
// transactional NUNCA pode ser desabilitado (base legal LGPD art. 7-V — execucao de contrato).
// marketing default = false: opt-in explicito conforme art. 7-I.
model EmailPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  transactional   Boolean  @default(true)
  alerts          Boolean  @default(true)
  product_updates Boolean  @default(true)
  marketing       Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_preferences")
}

model Subscription {
  id                  String    @id @default(cuid())
  userId              String    @unique
  tier                String    @default("free")
  status              String    @default("active")
  currentPeriodEnd    DateTime?
  trialEndsAt         DateTime?
  asaasCustomerId     String?
  asaasSubscriptionId String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Portfolio {
  id                  String     @id @default(cuid())
  userId              String
  name                String
  initialEquity       Decimal    @db.Decimal(18, 2)
  currentEquity       Decimal?   @db.Decimal(18, 2)   // Equity atual Quantfury (denominador da alavancagem)
  monthlyContribution Decimal    @db.Decimal(18, 2) @default(0)
  currency            String     @default("BRL")
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions           Position[]

  @@index([userId, createdAt])
  @@map("portfolios")
}

model Position {
  id          String    @id @default(cuid())
  portfolioId String
  ticker      String
  quantity    Decimal   @db.Decimal(18, 6)
  avgPrice    Decimal   @db.Decimal(18, 4)
  leverage    Decimal   @db.Decimal(6, 2) @default(1)
  isSeed      Boolean   @default(false)   // Semente permanente — âncora, nunca rotaciona
  isCycle     Boolean   @default(false)   // Ciclo — posição de rotação (vende quando esticar)
  openedAt    DateTime  @default(now())   // Data de abertura da posição (editável no formulário)
  lastVerdict String?                     // último veredito visto (histerese da rotação)
  verdictSince DateTime?                  // desde quando o veredito atual está ativo
  createdAt   DateTime  @default(now())

  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@map("positions")
}

model SellEvent {
  id          String   @id @default(cuid())
  portfolioId String
  ticker      String
  soldAt      DateTime @default(now())   // cooldown de recompra na rotação

  @@index([portfolioId, soldAt])
  @@map("sell_events")
}

model Watchlist {
  id        String           @id @default(cuid())
  userId    String
  name      String           @default("Default")
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WatchlistItem[]

  @@index([userId])
  @@map("watchlists")
}

model WatchlistItem {
  id          String    @id @default(cuid())
  watchlistId String
  ticker      String
  createdAt   DateTime  @default(now())

  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, ticker])
  @@map("watchlist_items")
}

model Alert {
  id        String   @id @default(cuid())
  userId    String
  ticker    String
  condition String
  threshold Decimal  @db.Decimal(18, 4)
  active    Boolean  @default(true)
  message   String?
  notifiedAt DateTime?              // última vez que disparou e notificou (anti-spam; re-arma ao limpar)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("alerts")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("system")
  title     String
  body      String
  url       String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@map("notifications")
}
