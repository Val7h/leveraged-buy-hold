# Production Stripe Keys - FILL IN WITH REAL KEYS
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_REAL_KEY_HERE
STRIPE_SECRET_KEY=sk_live_YOUR_REAL_KEY_HERE

# API Configuration
# VAZIO de propósito: o navegador deve chamar same-origin (o BFF do próprio Next),
# que proxia internamente pro FastAPI em 127.0.0.1:8001. NÃO apontar para
# api.lbhsystem.com (domínio do antigo lbh-backend, removido na consolidação) —
# isso embute uma URL morta no bundle e quebra TODAS as chamadas de dados no browser.
NEXT_PUBLIC_API_URL=
