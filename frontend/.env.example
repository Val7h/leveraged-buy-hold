# LBH System Frontend — .env.example
# Copie para .env.local e preencha. NUNCA commite .env.local real.

# === Cache (Upstash Redis - HTTP) ===
# Crie em https://console.upstash.com/redis (free tier: 10k cmd/dia).
# Sem estas vars, o app cai para cache in-memory (so 1 instancia / morre em cold-start).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === Database (Postgres) ===
# Render free tier: include sslmode=require
# Local dev: postgresql://user:pass@localhost:5432/lbh?schema=public
#
# Neon (recomendado): use POOLED connection (com `-pooler` no host) + pgbouncer=true
# A connection string aparece em https://console.neon.tech > seu_projeto > Connection Details
# IMPORTANTE: Neon free tier auto-suspende endpoint após 5min de inatividade.
# Ao reativar pode regenerar password. Se ver "Authentication failed",
# vá em Neon Console > Connection Details > "Reset password".
DATABASE_URL="postgresql://neondb_owner:PASS@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# DIRECT (sem pooler) — usado APENAS para migrations (Prisma migrate)
DIRECT_DATABASE_URL="postgresql://neondb_owner:PASS@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# === App ===
NODE_ENV=development
# URL publica da API (mesmo dominio do Next em prod).
NEXT_PUBLIC_API_URL=http://localhost:3000

# === Auth ===
# JWT signing secret (256 bits). Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-openssl-rand-base64-32"

# === Stripe (opcional - modo demo nao precisa) ===
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET=
